<% layout("/layout", { title: "Jokes", session: it.session }) %>
<% if (it.notice) { %>
<div class="alert alert-info mb-6 items-center" role="status">
	<span class="alert-icon" aria-hidden="true">✓</span>
	<p class="flex-1"><%= it.notice %></p>
	<a href="/admin/jokes" class="btn btn-plain btn-sm" aria-label="Dismiss notice">✕</a>
</div>
<% } %>
<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
	<div>
		<h1 class="font-display text-3xl leading-none sm:text-4xl">Jokes</h1>
		<p class="mt-2 font-medium">Every phrase and joke served by the API.</p>
	</div>
	<a href="/admin/jokes/new" class="btn btn-primary">+ New joke</a>
</div>
<form method="get" action="/admin/jokes" class="card mb-6 flex flex-col gap-3 p-4 sm:flex-row sm:items-end" role="search">
	<div class="sm:w-56">
		<label class="label" for="category">Category</label>
		<select class="field" id="category" name="category">
			<option value="">All</option>
			<% it.categories.forEach((category) => { %>
			<option value="<%= category %>"<%= category === it.filters.category ? " selected" : "" %>><%= category %></option>
			<% }) %>
		</select>
	</div>
	<div class="flex-1">
		<label class="label" for="q">Search</label>
		<input class="field" type="search" id="q" name="q" placeholder="Search content…" value="<%= it.filters.search %>">
	</div>
	<button type="submit" class="btn btn-navy">Filter</button>
</form>
<div class="card overflow-hidden">
	<div class="overflow-x-auto">
		<table class="jokes-table w-full min-w-[820px] text-left">
			<thead>
				<tr>
					<th scope="col">ID</th>
					<th scope="col">Type</th>
					<th scope="col">Content</th>
					<th scope="col">Category</th>
					<th scope="col" class="text-right">Up</th>
					<th scope="col" class="text-right">Down</th>
					<th scope="col" class="text-right">Views</th>
					<th scope="col" class="text-right">Actions</th>
				</tr>
			</thead>
			<tbody>
				<% it.jokes.forEach((joke) => { %>
				<tr>
					<td class="font-display text-sm"><%= joke.id %></td>
					<td><span class="sticker <%= joke.type === 'joke' ? 'sticker-joke' : 'sticker-phrase' %>"><%= joke.type %></span></td>
					<td><div class="max-w-[24rem] truncate" title="<%= joke.content %>"><%= joke.content %></div></td>
					<td><span class="chip"><%= joke.category %></span></td>
					<td class="text-right tabular-nums"><%= joke.upvotes %></td>
					<td class="text-right tabular-nums"><%= joke.downvotes %></td>
					<td class="text-right tabular-nums"><%= joke.views %></td>
					<td><div class="flex justify-end gap-2"><a class="btn btn-plain btn-sm" href="/admin/jokes/<%= joke.id %>/edit">Edit<span class="sr-only"> joke <%= joke.id %></span></a><a class="btn btn-danger btn-sm" href="/admin/jokes/<%= joke.id %>/delete">Delete<span class="sr-only"> joke <%= joke.id %></span></a></div></td>
				</tr>
				<% }) %>
			</tbody>
		</table>
	</div>
</div>
