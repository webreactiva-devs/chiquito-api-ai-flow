<% layout("/layout", { title: "Log in" }) %>
<div class="mx-auto w-full max-w-md py-4">
	<div class="mb-8 text-center">
		<p class="inline-block -rotate-3 rounded-full border-2 border-navy bg-tomato-deep px-3 py-1 font-display text-xs text-white shadow-hard-sm">Admin zone</p>
		<h1 class="mt-3 font-display text-4xl leading-none sm:text-5xl">Chiquito<br><span class="text-tomato-deep">Admin</span></h1>
		<p class="mt-3 font-medium">Log in to manage the jokes.</p>
	</div>
	<div class="card p-6 sm:p-8">
		<% if (it.notice) { %>
		<div class="alert alert-info mb-5" role="status">
			<span class="alert-icon" aria-hidden="true">i</span>
			<p><%= it.notice %></p>
		</div>
		<% } %>
		<% if (it.error) { %>
		<div class="alert alert-error mb-5" role="alert">
			<span class="alert-icon" aria-hidden="true">!</span>
			<p><%= it.error %></p>
		</div>
		<% } %>
		<form method="post" action="/admin/login" class="space-y-5">
			<% if (it.next) { %>
			<input type="hidden" name="next" value="<%= it.next %>">
			<% } %>
			<div>
				<label class="label" for="email">Email</label>
				<input class="field" id="email" name="email" type="email" autocomplete="username" value="<%= it.email ?? '' %>" required>
			</div>
			<div>
				<label class="label" for="password">Password</label>
				<input class="field" id="password" name="password" type="password" autocomplete="current-password" required>
			</div>
			<button type="submit" class="btn btn-primary w-full text-lg">Log in</button>
		</form>
	</div>
</div>
