{
  "permissions": {
    "allow": [
      "Bash(npx biome:*)",
      "Bash(npm test)",
      "Bash(npm install:*)",
      "Bash(curl:*)",
      "Bash(npm run test:integration:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm run db:init:*)",
      "Bash(npm run test:unit:*)",
      "Bash(npm run format:*)",
      "Bash(npm run check:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npm test"
          },
          {
            "type": "command",
            "command": "npm run lint"
          },
          {
            "type": "command",
            "command": "npm run check"
          }
        ]
      }
    ]
  }
}
