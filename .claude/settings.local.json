{
  "permissions": {
    "allow": [
      "Bash(npx biome:*)",
      "Bash(npm test)",
      "Bash(npm install:*)",
      "Bash(curl:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npm test"
          }
        ]
      }
    ]
  }
}
