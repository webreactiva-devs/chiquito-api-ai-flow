{
  "name": "chiquito-api-jarl",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tailwindcss -i src/admin/styles/input.css -o public/admin/admin.css --watch & tsx watch src/server.ts",
    "build": "npm run build:css && tsc",
    "db:init": "tsx src/db/init.ts",
    "test:types": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage",
    "test": "npm run test:types && npm run check && vitest run",
    "lint": "biome lint src tests",
    "format": "biome format --write src tests",
    "check": "biome check src tests",
    "admin:create": "tsx src/cli/admin-main.ts create",
    "build:css": "tailwindcss -i src/admin/styles/input.css -o public/admin/admin.css --minify"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/view": "^12.0.0",
    "better-sqlite3": "^12.4.6",
    "eta": "^4.6.0",
    "fastify": "^5.6.2"
  },
  "engines": {
    "node": ">=21.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@tailwindcss/cli": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.13",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
}
